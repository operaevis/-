        inbound credit revocation. Signals authorized emergency swap overdraft and policy rollback.
      tags:
        - Webhooks
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SupervisorPlaneBreachWebhook'
            examples:
              whitepaperContract3:
                summary: Representative Contract 3 (integer-migrated µOPVS fields)
                value:
                  event: supervisor.plane_breach
                  timestamp: "2026-11-23T00:11:04.220Z"
                  wallet_id: wlt_unit_09
                  policy_version: policy_v2.5_exp
                  geometry:
                    x_work_mj: 412.8
                    y_balance_micro_opvs: 2140000
                    z_swap_cost_micro_opvs: 3410000
                    d_s_altitude_micro_opvs: -1270000
                    intrinsic_pitch_deg: -6.4
                  auto_action:
                    physical_swap: AUTHORIZED_OVERDRAFT
                    policy_state: QUARANTINED
                    rollback_target: policy_v2.4_margin
      responses:
        '200':
          description: Breach event acknowledged by Supervisor Console and AI Policy Server

components:
  securitySchemes:
    mTLS:
      type: mutualTLS
      description: Mutual TLS 1.3 client certificate authentication inside isolated site VPC
    OpvsSignature:
      type: apiKey
      in: header
      name: X-Opvs-Signature
      description: Detached Ed25519 signature over canonical request payload (prefixed with ed25519:)

  parameters:
    IdempotencyKey:
      name: Idempotency-Key
      in: header
      required: true
      description: Unique UUID v4 generated per logical write request to guarantee idempotent retries
      schema:
        type: string
        format: uuid
    WalletId:
      name: id
      in: path
      required: true
      description: Unique robot wallet identifier
      schema:
        type: string
        pattern: '^wlt_[a-z0-9_]+$'

  responses:
    IdempotencyConflict:
      description: Reused Idempotency-Key with altered payload; write rejected and escalated to OT security
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorResponse'
          examples:
            conflict409:
              value:
                error_code: IDEMPOTENCY_PAYLOAD_MISMATCH
                message: Reused Idempotency-Key with altered request body; escalated to OT security.
                ot_security_alert: true
    UnprocessablePayload:
      description: Invalid Ed25519 signature, physically impossible ΔWh, or invariant violation
      content:
        application/json:
          schema:
            $ref: '#/components/schemas/ErrorResponse'
          examples:
            invalidDelta422:
              value:
                error_code: PHYSICALLY_IMPOSSIBLE_DELTA_WH
                message: Transaction quarantined to anomaly log; bay-level fallback swap authorization preserved.
                quarantine_log_id: anom_01JDF9Z01

  schemas:
    EconomicMode:
      type: string
      enum:
        - NOMINAL
        - CONSERVATION
        - SOFT_BANKRUPTCY

    GovernanceZone:
      type: string
      enum:
        - ZONE_0_ASCENDING
        - ZONE_1_STASIS
        - ZONE_2_CONSERVATION
        - ZONE_3_PLANE_BREACH

    BatteryPackTelemetry:
      type: object
      additionalProperties: false
      required:
        - pack_id
        - soc_pct
      properties:
        pack_id:
          type: string
        soc_pct:
          type: number
          minimum: 0
          maximum: 100
        wh_remaining:
          type: integer
          format: int64
          minimum: 0
        wh_available:
          type: integer
          format: int64
          minimum: 0

    SwapSettleRequest:
      type: object
      additionalProperties: false
      required:
        - wallet_id
        - station_id
        - episode_id
        - pack_returned
        - pack_dispensed
        - energy_delta_wh
        - swap_duration_sec
        - bms_signature
      properties:
        wallet_id:
          type: string
        station_id:
          type: string
        episode_id:
          type: string
        pack_returned:
          $ref: '#/components/schemas/BatteryPackTelemetry'
        pack_dispensed:
          $ref: '#/components/schemas/BatteryPackTelemetry'
        energy_delta_wh:
          type: integer
          format: int64
          minimum: 0
          description: Net energy replenished in integer Wh (1 Wh = 1,000 µOPVS)
        swap_duration_sec:
          type: integer
          format: int32
          minimum: 1
        bms_signature:
          type: string
          pattern: '^ed25519:[a-f0-9]+'

    SwapSettleResponse:
      type: object
      additionalProperties: false
      required:
        - tx_id
        - status
        - amount_debited_micro_opvs
        - balance_after_micro_opvs
        - economic_mode
        - ledger_hash
      properties:
        tx_id:
          type: string
        status:
          type: string
          enum:
            - SETTLED
        amount_debited_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        balance_after_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        overdraft_granted_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        economic_mode:
          $ref: '#/components/schemas/EconomicMode'
        ledger_hash:
          type: string

    TaskSettleRequest:
      type: object
      additionalProperties: false
      required:
        - wallet_id
        - task_id
        - episode_id
        - policy_version
        - action_plan_hash
        - started_at
        - ended_at
        - wage_micro_opvs
        - work_delta_mj
        - torque_squared_integral
        - peak_joint_temp_c
        - mes_signature
      properties:
        wallet_id:
          type: string
        task_id:
          type: string
        episode_id:
          type: string
        policy_version:
          type: string
        action_plan_hash:
          type: string
        started_at:
          type: string
          format: date-time
        ended_at:
          type: string
          format: date-time
        wage_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        work_delta_mj:
          type: number
          minimum: 0
        torque_squared_integral:
          type: number
          minimum: 0
        peak_joint_temp_c:
          type: number
        mes_signature:
          type: string

    TaskSettleResponse:
      type: object
      additionalProperties: false
      required:
        - tx_id
        - status
        - wage_credited_micro_opvs
        - maintenance_escrow_micro_opvs
        - net_margin_micro_opvs
        - balance_after_micro_opvs
        - manifold_altitude_micro_opvs
        - governance_zone
        - economic_mode
        - ledger_hash
      properties:
        tx_id:
          type: string
        status:
          type: string
          enum:
            - SETTLED
        wage_credited_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        maintenance_escrow_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        net_margin_micro_opvs:
          type: integer
          format: int64
        balance_after_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        manifold_altitude_micro_opvs:
          type: integer
          format: int64
        governance_zone:
          $ref: '#/components/schemas/GovernanceZone'
        economic_mode:
          $ref: '#/components/schemas/EconomicMode'
        ledger_hash:
          type: string

    WalletStateResponse:
      type: object
      additionalProperties: false
      required:
        - wallet_id
        - timestamp
        - operational_liquidity_micro_opvs
        - maintenance_escrow_micro_opvs
        - cumulative_income_micro_opvs
        - manifold_altitude_micro_opvs
        - altitude_velocity_micro_opvs_per_hour
        - climb_pitch_apparent_deg
        - climb_pitch_intrinsic_deg
        - governance_zone
        - economic_mode
        - policy_authority
        - zombie_helix_flag
        - active_policy_version
      properties:
        wallet_id:
          type: string
        timestamp:
          type: string
          format: date-time
        operational_liquidity_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        maintenance_escrow_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        cumulative_income_micro_opvs:
          type: integer
          format: int64
        manifold_altitude_micro_opvs:
          type: integer
          format: int64
        altitude_velocity_micro_opvs_per_hour:
          type: integer
          format: int64
        climb_pitch_apparent_deg:
          type: number
        climb_pitch_intrinsic_deg:
          type: number
        time_to_zero_hours:
          type:
            - number
            - 'null'
          minimum: 0
        governance_zone:
          $ref: '#/components/schemas/GovernanceZone'
        economic_mode:
          $ref: '#/components/schemas/EconomicMode'
        policy_authority:
          type: string
          enum:
            - SURVIVOR
            - FROZEN
            - RESTRICTED
            - QUARANTINED
        zombie_helix_flag:
          type: boolean
        active_policy_version:
          type: string

    M2mTransferRequest:
      type: object
      additionalProperties: false
      required:
        - from_wallet_id
        - to_wallet_id
        - episode_id
        - transfer_type
        - amount_micro_opvs
        - sender_signature
      properties:
        from_wallet_id:
          type: string
        to_wallet_id:
          type: string
        episode_id:
          type: string
        transfer_type:
          type: string
          enum:
            - SUBCONTRACT
            - LIQUIDITY_LOAN
            - M2M_TIP
        amount_micro_opvs:
          type: integer
          format: int64
          minimum: 1
        task_ref:
          type: string
        sender_signature:
          type: string

    M2mTransferResponse:
      type: object
      additionalProperties: false
      required:
        - tx_id
        - status
        - amount_micro_opvs
        - sender_balance_after_micro_opvs
        - recipient_balance_after_micro_opvs
        - economic_mode
        - ledger_hash
      properties:
        tx_id:
          type: string
        status:
          type: string
          enum:
            - SETTLED
        amount_micro_opvs:
          type: integer
          format: int64
          minimum: 1
        sender_balance_after_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        recipient_balance_after_micro_opvs:
          type: integer
          format: int64
          minimum: 0
        economic_mode:
          $ref: '#/components/schemas/EconomicMode'
        ledger_hash:
          type: string

    TipRequest:
      type: object
      additionalProperties: false
      required:
        - episode_id
        - operator_id
        - amount_micro_opvs
        - reason_code
        - operator_signature
      properties:
        episode_id:
          type: string
        operator_id:
          type: string
        amount_micro_opvs:
          type: integer
          format: int64
          minimum: 1
        reason_code:
          type: string
          enum:
            - PRECISION_BONUS
            - EDGE_CASE_RECOVERY
            - SAFETY_ASSIST
        operator_signature:
          type: string

    TipResponse:
      type: object
      additionalProperties: false
      required:
        - tx_id
