openapi: 3.1.0
info:
  title: OPVS Core API
  version: 1.0.0
  summary: Thermodynamic settlement protocol API for autonomous machine economies
  description: |
    Private permissioned ledger API for OPVS (Operae Vis System), operated by OPERAE VIS (operaevis.com).
    Strict physical parity: 1 OPVS = 1 kWh = 3.6 MJ = 1,000,000 micro-OPVS (1 µOPVS = 3.6 J).
    All monetary balances, debits, credits, margins, and survival manifold altitudes are strictly
    represented as signed or unsigned 64-bit integers in µOPVS. Zero floating-point amounts.
  contact:
    name: OPERAE VIS
    url: https://operaevis.com
  license:
    name: Proprietary

servers:
  - url: https://ledger.site.internal
    description: Isolated site VPC hosting the private permissioned OPVS Core Ledger

security:
  - mTLS: []
    OpvsSignature: []

tags:
  - name: Settlements
    description: Atomic battery swap and verified task settlements
  - name: Wallets
    description: Real-time geometric state, M2M transfers, and human tipping
  - name: Audit
    description: Verifiable machine balance sheets and Merkle closure proofs
  - name: Webhooks
    description: Signed outbound events for AI policy rewards and Supervisor breaches

paths:
  /v1/swaps/settle:
    post:
      operationId: settleBatterySwap
      summary: Atomic battery swap settlement
      description: |
        Triggered by the swap station BMS the instant a fresh battery pack locks into a unit.
        Debits the robot wallet at strict energy parity (1,000 µOPVS per Wh). If operational
        liquidity is insufficient, authorizes an emergency overdraft (SOFT_BANKRUPTCY) so physical
        production never halts while quarantining the active AI policy.
      tags:
        - Settlements
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/SwapSettleRequest'
            examples:
              whitepaperContract1:
                summary: Representative Contract 1 (3,271 Wh = 3,271,000 µOPVS)
                value:
                  wallet_id: wlt_unit_04
                  station_id: swap_bay_site_02
                  episode_id: ep_20261123_04_019
                  pack_returned:
                    pack_id: bat_8812
                    soc_pct: 11.4
                    wh_remaining: 422
                  pack_dispensed:
                    pack_id: bat_9041
                    soc_pct: 99.8
                    wh_available: 3693
                  energy_delta_wh: 3271
                  swap_duration_sec: 148
                  bms_signature: "ed25519:a8f4c19d2e7b03..."
      responses:
        '200':
          description: Swap settled (NOMINAL, CONSERVATION, or SOFT_BANKRUPTCY emergency credit)
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/SwapSettleResponse'
              examples:
                whitepaperContract1Ok:
                  summary: Representative Contract 1 Response
                  value:
                    tx_id: tx_swap_01JDF9X8K2
                    status: SETTLED
                    amount_debited_micro_opvs: 3271000
                    balance_after_micro_opvs: 482150000
                    overdraft_granted_micro_opvs: 0
                    economic_mode: NOMINAL
                    ledger_hash: "sha256:7e3b90f12a44c8..."
        '409':
          $ref: '#/components/responses/IdempotencyConflict'
        '422':
          $ref: '#/components/responses/UnprocessablePayload'

  /v1/tasks/settle:
    post:
      operationId: settleTask
      summary: Settle verified industrial task wage and maintenance escrow
      description: |
        Called by the factory MES or Dispatcher upon task completion. Credits verified task wage,
        computes maintenance escrow via the curved Survival Manifold S (baseline depreciation,
        quadratic torque fatigue, exponential thermal wall), and settles canonical net margin
        (ΔM = Wage - E_swap - ΔR_maint) in integer µOPVS.
      tags:
        - Settlements
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TaskSettleRequest'
            examples:
              nominalTask:
                summary: Verified handling task settlement
                value:
                  wallet_id: wlt_unit_04
                  task_id: tsk_frame_weld_884
                  episode_id: ep_20261123_04_019
                  policy_version: policy_v2.4_margin
                  action_plan_hash: "sha256:4b91e0..."
                  started_at: "2026-11-23T14:01:00.000Z"
                  ended_at: "2026-11-23T14:22:08.500Z"
                  wage_micro_opvs: 8581000
                  work_delta_mj: 44.2
                  torque_squared_integral: 1824.5
                  peak_joint_temp_c: 54.2
                  mes_signature: "ed25519:19bc02..."
      responses:
        '200':
          description: Task wage credited and maintenance escrow settled
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TaskSettleResponse'
              examples:
                taskSettledOk:
                  summary: Nominal task margin settlement
                  value:
                    tx_id: tx_task_01JDFB2M90
                    status: SETTLED
                    wage_credited_micro_opvs: 8581000
                    maintenance_escrow_micro_opvs: 1000000
                    net_margin_micro_opvs: 4310000
                    balance_after_micro_opvs: 486460000
                    manifold_altitude_micro_opvs: 42180000
                    governance_zone: ZONE_0_ASCENDING
                    economic_mode: NOMINAL
                    ledger_hash: "sha256:88ac12..."
        '409':
          $ref: '#/components/responses/IdempotencyConflict'
        '422':
          $ref: '#/components/responses/UnprocessablePayload'

  /v1/wallets/{id}/state:
    get:
      operationId: getWalletState
      summary: Read wallet sub-ledgers and Survival Manifold state scalars
      description: |
        Returns operational liquidity, maintenance escrow, cumulative income statement, signed
        manifold altitude d_S, apparent/intrinsic climb pitch, time-to-zero, and active
        Supervisor governance zone.
      tags:
        - Wallets
      parameters:
        - $ref: '#/components/parameters/WalletId'
      responses:
        '200':
          description: Current wallet and Supervisor geometric state
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/WalletStateResponse'
              examples:
                ascendingUnit:
                  summary: Zone 0 Ascending unit
                  value:
                    wallet_id: wlt_unit_04
                    timestamp: "2026-11-23T14:22:09.114Z"
                    operational_liquidity_micro_opvs: 486460000
                    maintenance_escrow_micro_opvs: 38200000
                    cumulative_income_micro_opvs: 141200000
                    manifold_altitude_micro_opvs: 42180000
                    altitude_velocity_micro_opvs_per_hour: 920000
                    climb_pitch_apparent_deg: 7.1
                    climb_pitch_intrinsic_deg: 7.1
                    time_to_zero_hours: null
                    governance_zone: ZONE_0_ASCENDING
                    economic_mode: NOMINAL
                    policy_authority: SURVIVOR
                    zombie_helix_flag: false
                    active_policy_version: policy_v2.4_margin
        '422':
          $ref: '#/components/responses/UnprocessablePayload'

  /v1/m2m/transfer:
    post:
      operationId: executeM2mTransfer
      summary: Execute peer-to-peer M2M settlement or liquidity transfer
      description: |
        Executes M2M subcontracting, peer tipping, or authorized liquidity lending between two
        robot wallets. Rejected (422) if the recipient is under Zombie Helix inbound credit
        revocation or if M2M lending caps are exceeded.
      tags:
        - Wallets
      parameters:
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/M2mTransferRequest'
            examples:
              subcontractTransfer:
                summary: Peer task subcontracting transfer
                value:
                  from_wallet_id: wlt_unit_01
                  to_wallet_id: wlt_unit_08
                  episode_id: ep_20261123_01_020
                  transfer_type: SUBCONTRACT
                  amount_micro_opvs: 1500000
                  task_ref: tsk_seq_204
                  sender_signature: "ed25519:5c01ef..."
      responses:
        '200':
          description: M2M transfer settled on ledger
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/M2mTransferResponse'
              examples:
                m2mSettledOk:
                  summary: Settled peer subcontracting transfer
                  value:
                    tx_id: tx_m2m_01JDFC40AA
                    status: SETTLED
                    amount_micro_opvs: 1500000
                    sender_balance_after_micro_opvs: 516920000
                    recipient_balance_after_micro_opvs: 10920000
                    economic_mode: NOMINAL
                    ledger_hash: "sha256:2f990d..."
        '409':
          $ref: '#/components/responses/IdempotencyConflict'
        '422':
          $ref: '#/components/responses/UnprocessablePayload'

  /v1/wallets/{id}/tip:
    post:
      operationId: creditHumanTip
      summary: Credit manual human-to-robot tip (TIP)
      description: |
        Credits a human-in-the-loop micro-tip in integer µOPVS from an authorized factory
        supervisor or technician (2016 conceptual lineage).
      tags:
        - Wallets
      parameters:
        - $ref: '#/components/parameters/WalletId'
        - $ref: '#/components/parameters/IdempotencyKey'
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/TipRequest'
            examples:
              precisionTip:
                summary: Human technician tip for safe edge-case recovery
                value:
                  episode_id: ep_20261123_04_019
                  operator_id: op_tech_07
                  amount_micro_opvs: 250000
                  reason_code: EDGE_CASE_RECOVERY
                  operator_signature: "ed25519:c204ab..."
      responses:
        '200':
          description: Human tip credited to operational liquidity and income statement
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/TipResponse'
              examples:
                tipSettledOk:
                  summary: Settled tip response
                  value:
                    tx_id: tx_tip_01JDFC881P
                    wallet_id: wlt_unit_04
                    status: SETTLED
                    amount_micro_opvs: 250000
                    balance_after_micro_opvs: 486710000
                    ledger_hash: "sha256:6b310a..."
        '409':
          $ref: '#/components/responses/IdempotencyConflict'
        '422':
          $ref: '#/components/responses/UnprocessablePayload'

  /v1/audit/balance-sheet/{id}:
    get:
      operationId: getAuditBalanceSheet
      summary: Export audited machine balance sheet and Merkle proof
      description: |
        Generates a cryptographically verifiable machine financial statement combining income
        statement, energy cash flow, and Merkle audit proof anchored to Kirchhoff site closure.
      tags:
        - Audit
      parameters:
        - $ref: '#/components/parameters/WalletId'
        - name: from
          in: query
          required: false
          description: Start of audit window (ISO 8601 UTC)
          schema:
            type: string
            format: date-time
        - name: to
          in: query
          required: false
          description: End of audit window (ISO 8601 UTC)
          schema:
            type: string
            format: date-time
      responses:
        '200':
          description: Machine income statement, energy cash flow, and Merkle proof
          content:
            application/json:
              schema:
                $ref: '#/components/schemas/AuditBalanceSheetResponse'
              examples:
                balanceSheetDay90:
                  summary: Audited unit balance sheet export
                  value:
                    wallet_id: wlt_unit_04
                    period_start: "2026-11-23T00:00:00Z"
                    period_end: "2026-11-23T23:59:59Z"
                    parity_invariant: "1 OPVS = 1 kWh = 1000000 micro_opvs"
                    income_statement:
                      total_wage_micro_opvs: 25743000
                      total_tips_micro_opvs: 250000
                      total_swap_energy_micro_opvs: 9813000
                      total_maintenance_escrow_micro_opvs: 3000000
                      total_m2m_net_micro_opvs: 0
                      total_overdraft_penalties_micro_opvs: 0
                      net_margin_micro_opvs: 13180000
                    energy_cash_flow:
                      opening_liquidity_micro_opvs: 473530000
                      closing_liquidity_micro_opvs: 486710000
                      total_energy_debited_wh: 9813
                      avg_intrinsic_pitch_deg: 7.1
                    merkle_proof:
                      merkle_root: "sha256:99d41e..."
                      ledger_head_hash: "sha256:6b310a..."
                      entry_count: 14
                      kirchhoff_site_status: CLOSED_WITHIN_TOLERANCE
        '422':
          $ref: '#/components/responses/UnprocessablePayload'

webhooks:
  reward.margin_settled:
    post:
      operationId: webhookRewardMarginSettled
      summary: Ground-truth margin reward webhook to embodied AI policy server
      description: |
        Emitted immediately after task or swap settlement so embodied AI policies train and
        evaluate directly against real net margin in integer µOPVS.
      tags:
        - Webhooks
      requestBody:
        required: true
        content:
          application/json:
            schema:
              $ref: '#/components/schemas/RewardMarginSettledWebhook'
            examples:
              whitepaperContract2:
                summary: Representative Contract 2 (integer-migrated µOPVS fields)
                value:
                  event_id: evt_01JDFB2N11
                  timestamp: "2026-11-23T14:22:09.114Z"
                  wallet_id: wlt_unit_04
                  episode_id: ep_20261123_04_019
                  policy_version: policy_v2.4_margin
                  reward_signal:
                    net_margin_micro_opvs: 4310000
